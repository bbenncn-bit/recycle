/// 材料成本缓存表（LIFO 预计算结果）
model MaterialCostCache {
  id                    Int       @id @default(autoincrement()) @map("id")
  deliveryNumber        String?   @db.VarChar(100) @unique @map("delivery_number")  // 发货单号（唯一标识）
  productName           String?   @db.VarChar(100) @map("product_name")             // 成品名称
  productWarehouse      String?   @db.VarChar(100) @map("product_warehouse")        // 成品仓库
  deliveryDate          String?   @db.VarChar(50) @map("delivery_date")             // 发货日期
  settlementQuantity    Decimal?  @db.Decimal(18, 2) @map("settlement_quantity")    // 结算数量（吨）
  materialCost          Decimal?  @db.Decimal(18, 2) @map("material_cost")           // 材料成本（元）
  materialComposition   Json?     @map("material_composition")                       // 材料构成 JSON
  productionRecords     Json?     @map("production_records")                        // 使用的生产记录 JSON
  calculatedAt          DateTime? @default(now()) @map("calculated_at") @db.Timestamp(0)  // 计算时间
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)      // 更新时间

  @@index([deliveryNumber])
  @@index([productName, productWarehouse])
  @@index([deliveryDate])
  @@map("MaterialCostCache")
}

/// 材料成本缓存刷新日志（运维每次刷新写入一条汇总）
model MaterialCostCacheErrorLog {
  id             Int       @id @default(autoincrement()) @map("id")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  deliveryNumber String?   @db.VarChar(100) @map("delivery_number")
  errorMessage   String?   @db.Text @map("error_message")

  @@index([createdAt])
  @@map("MaterialCostCacheErrorLog")
}

