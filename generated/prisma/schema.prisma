/// 固废管理 - 工业固体废物信息表
model WasteManagement {
  id                Int       @id @default(autoincrement())
  wasteCode         String?   @db.VarChar(100) // 固废代码
  wasteName         String?   @db.VarChar(255) // 固废名称
  wasteCategory     String?   @db.VarChar(100) // 固废类别（危险废物/一般工业固废等）
  wasteType         String?   @db.VarChar(100) // 固废种类
  quantity          Decimal?  @db.Decimal(15, 3) // 数量
  unit              String?   @db.VarChar(50) // 单位（吨、立方米等）
  source            String?   @db.VarChar(255) // 产生来源/产生环节
  flowDirection     String?   @db.VarChar(255) // 流向（去向）
  storageLocation   String?   @db.VarChar(255) // 贮存地点
  storageMethod     String?   @db.VarChar(255) // 贮存方式
  utilizationMethod String?   @db.VarChar(255) // 利用方式
  disposalMethod    String?   @db.VarChar(255) // 处置方式
  disposalUnit      String?   @db.VarChar(255) // 处置单位
  disposalLocation  String?   @db.VarChar(255) // 处置地点
  recordDate        DateTime? @db.Date // 记录日期
  operator          String?   @db.VarChar(100) // 操作员/安全员
  remark            String?   @db.Text // 备注
  createTime        DateTime? @default(now()) @db.Timestamp(0) // 创建时间
  updateTime        DateTime? @updatedAt @db.Timestamp(0) // 更新时间
}

/// 入库单表（采购成本数据）
model PurchaseWarehouse {
  id                              Int       @id @default(autoincrement()) @map("id")
  ledgerNo                        String?   @map("ledger_no") @db.VarChar(100) // 账套号
  warehouseNo                     String?   @map("warehouse_no") @db.VarChar(100) // 入库单号
  purchaseContractNo              String?   @map("purchase_contract_no") @db.VarChar(100) // 采购合同编号
  purchaseOrderNo                 String?   @map("purchase_order_no") @db.VarChar(100) // 采购订单编号
  warehouseTime                   String?   @map("warehouse_time") @db.VarChar(50) // 入库时间
  status                          String?   @map("status") @db.VarChar(50) // 状态
  settlementStatus                String?   @map("settlement_status") @db.VarChar(50) // 结算状态
  receiptNo                       String?   @map("receipt_no") @db.VarChar(100) // 收货单号
  base                            String?   @map("base") @db.VarChar(200) // 基地
  supplier                        String?   @map("supplier") @db.VarChar(200) // 供应商
  vehicleNo                       String?   @map("vehicle_no") @db.VarChar(100) // 车船号
  warehouse                       String?   @map("warehouse") @db.VarChar(100) // 仓库
  warehouseArea                   String?   @map("warehouse_area") @db.VarChar(100) // 库区
  material                        String?   @map("material") @db.VarChar(100) // 物料（废钢类型）
  grossWeight                     Decimal?  @map("gross_weight") @db.Decimal(18, 2) // 毛重
  tareWeight                      Decimal?  @map("tare_weight") @db.Decimal(18, 2) // 皮重
  netWeight                       Decimal?  @map("net_weight") @db.Decimal(18, 2) // 净重
  deduction                       Decimal?  @map("deduction") @db.Decimal(18, 2) // 扣杂
  estimatedDryBasis               Decimal?  @map("estimated_dry_basis") @db.Decimal(18, 2) // 预估干基
  supplierWeightData              String?   @map("supplier_weight_data") @db.Text // 供应商磅单数据
  qualityInspector                String?   @map("quality_inspector") @db.VarChar(100) // 质检审批人
  qualityInspectTime              String?   @map("quality_inspect_time") @db.VarChar(50) // 质检审批时间
  unitPriceExcludingTax           Decimal?  @map("unit_price_excluding_tax") @db.Decimal(18, 8) // 单价（不含税）
  totalPriceExcludingTax          Decimal?  @map("total_price_excluding_tax") @db.Decimal(18, 2) // 总价（不含税）
  warehouseDate                   String?   @map("warehouse_date") @db.VarChar(20) // 入库日期（字符串格式）
  remark                          String?   @map("remark") @db.Text // 备注
  creator                         String?   @map("creator") @db.VarChar(100) // 制单人
  createTime                      String?   @map("create_time") @db.VarChar(50) // 创建时间
  shippingVesselNo                String?   @map("shipping_vessel_no") @db.VarChar(100) // 发运船号
  qualityChecker                  String?   @map("quality_checker") @db.VarChar(100) // 质检员
  inboundWeighingPerson           String?   @map("inbound_weighing_person") @db.VarChar(100) // 入场称重员
  inboundTime                     String?   @map("inbound_time") @db.VarChar(50) // 入场时间
  outboundWeighingPerson          String?   @map("outbound_weighing_person") @db.VarChar(100) // 出场称重员
  confirmDate                     String?   @map("confirm_date") @db.VarChar(50) // 确认日期
  taxRate                         Decimal?  @map("tax_rate") @db.Decimal(5, 2) // 税率
  taxAmount                       Decimal?  @map("tax_amount") @db.Decimal(18, 2) // 税额
  unitPriceIncludingTax           Decimal?  @map("unit_price_including_tax") @db.Decimal(18, 8) // 单价（含税）
  totalPriceIncludingTax          Decimal?  @map("total_price_including_tax") @db.Decimal(18, 2) // 总价（含税）- 成本计算字段
  grade                           String?   @map("grade") @db.VarChar(100) // 品位
  confirmer                       String?   @map("confirmer") @db.VarChar(100) // 确认人
  supplierWeightTotalExcludingTax Decimal?  @map("supplier_weight_total_excluding_tax") @db.Decimal(18, 2) // 供应商磅单总价（不含税）
  supplierWeightTotalIncludingTax Decimal?  @map("supplier_weight_total_including_tax") @db.Decimal(18, 2) // 供应商磅单总价（含税）
  businessType                    String?   @map("business_type") @db.VarChar(100) // 业务类型
  warehouseType                   String?   @map("warehouse_type") @db.VarChar(100) // 入库类型
  endUser                         String?   @map("end_user") @db.VarChar(200) // 终端用户
  weighingTime                    String?   @map("weighing_time") @db.VarChar(50) // 磅单时间
  supplierNo                      String?   @map("supplier_no") @db.VarChar(100) // 供货方编号
  supplierName                    String?   @map("supplier_name") @db.VarChar(200) // 供货方
  supplierContact                 String?   @map("supplier_contact") @db.VarChar(100) // 供货方联系方式
  qualityUnitPrice                Decimal?  @map("quality_unit_price") @db.Decimal(18, 8) // 质检单价
  purchaseContractNo2             String?   @map("purchase_contract_no_2") @db.VarChar(100) // 采购合同编号（重复字段）
  purchaseOrderNo2                String?   @map("purchase_order_no_2") @db.VarChar(100) // 采购订单编号（重复字段）
  salesOrderNo                    String?   @map("sales_order_no") @db.VarChar(100) // 销售订单号
  paymentReceiptNo                String?   @map("payment_receipt_no") @db.VarChar(100) // 收付单号
  weighingBatchNo                 String?   @map("weighing_batch_no") @db.VarChar(100) // 磅单批次号
  isManualAdd                     String?   @map("is_manual_add") @db.VarChar(10) // 是否手工新增
  redFlushStatus                  String?   @map("red_flush_status") @db.VarChar(50) // 红冲状态
  redFlushedOrderNo               String?   @map("red_flushed_order_no") @db.VarChar(100) // 被红冲单号
  revokeStatus                    String?   @map("revoke_status") @db.VarChar(50) // 撤销状态
  revokeFailReason                String?   @map("revoke_fail_reason") @db.Text // 撤销失败原因
  revokeApproved                  String?   @map("revoke_approved") @db.VarChar(10) // 撤销是否审批
  driverName                      String?   @map("driver_name") @db.VarChar(100) // 司机姓名
  driverPhone                     String?   @map("driver_phone") @db.VarChar(100) // 司机手机号码
  createdAt                       DateTime? @default(now()) @map("created_at") @db.Timestamp(0) // 记录创建时间
  updatedAt                       DateTime? @updatedAt @map("updated_at") @db.Timestamp(0) // 记录更新时间

  @@index([warehouseNo])
  @@index([supplier])
  @@index([material])
  @@index([status])
  @@map("PurchaseWarehouse")
}

