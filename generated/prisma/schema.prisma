  materialType  String?  @map("material_type") @db.VarChar(100)
  aliasName     String?  @map("alias_name") @db.VarChar(80)
  currentQty    Decimal? @map("current_qty") @db.Decimal(18, 4)
  currentPrice  Decimal? @map("current_price") @db.Decimal(18, 4)
