  updateBy      String?  @map("updateBy") @db.VarChar(100)
  updatedAt     String?  @map("updatedAt") @db.VarChar(50)
  qty20260331   Decimal? @map("20260331_qty") @db.Decimal(18, 4)
  price20260331 Decimal? @map("20260331_price") @db.Decimal(18, 4)

  @@index([storageArea])
  @@index([aliasName])
