  vehicleNumber         String?   @map("vehicle_number") @db.VarChar(50) // 车船号
  netWeight             Decimal?  @map("net_weight") @db.Decimal(10, 2) // 净重（吨）
  factoryNetWeight      Decimal?  @map("factory_net_weight") @db.Decimal(10, 2) // 钢厂净重（吨）
  deductionRate         Decimal?  @map("deduction_rate") @db.Decimal(5, 3) // 扣杂率
  deliveryQuantity      Int?      @map("delivery_quantity") // 发货数量
  settlementQuantity    Decimal?  @map("settlement_quantity") @db.Decimal(10, 2) // 结算量（吨）
  totalSettlementAmount Decimal?  @map("total_settlement_amount") @db.Decimal(12, 2) // 合计结算金额（元）- 销售收入
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([deliveryDate])
  @@index([warehouse])
  @@index([productType])
  @@map("DeliverySettlement")
}

/// 利润核算可调参数表（运输费/税费/即征即退/政府扶持/贴现/回款利息等，附图标红参数）
/// 规则：按结算单发货日期查找，effective_date 起用 value，之前用 previous_value
model ProfitParamConfig {
  id            Int       @id @default(autoincrement()) @map("id")
  paramKey      String    @map("param_key") @db.VarChar(80) // 参数键（英文）
  nameCn        String    @map("name_cn") @db.VarChar(200) // 参数中文名称/注释
  category      String    @map("category") @db.VarChar(30) // other_cost / other_income
  subCategory   String?   @map("sub_category") @db.VarChar(50) // transport/tax/instant_refund/gov_subsidy/discount/interest
  steelMill     String?   @map("steel_mill") @db.VarChar(30) // 萍钢/吉钢/新钢，NULL=通用
  effectiveDate DateTime  @map("effective_date") @db.Date // 生效日期（精确到日）
  value         Decimal   @map("value") @db.Decimal(18, 6) // 参数值（新标准）
  previousValue Decimal?  @map("previous_value") @db.Decimal(18, 6) // 变动前的值（可选）
  unit          String?   @map("unit") @db.VarChar(30) // 单位
  remark        String?   @map("remark") @db.VarChar(500)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)

  @@unique([paramKey, steelMill, effectiveDate])
  @@index([paramKey])
  @@index([effectiveDate])
  @@index([category])
  @@map("ProfitParamConfig")
}

