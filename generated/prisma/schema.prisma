/// 材料成本缓存表（LIFO 预计算结果）
model MaterialCostCache {
  id                  Int       @id @default(autoincrement()) @map("id")
  deliveryNumber      String?   @unique @map("delivery_number") @db.VarChar(100) // 发货单号（唯一标识）
  productName         String?   @map("product_name") @db.VarChar(100) // 成品名称
  productWarehouse    String?   @map("product_warehouse") @db.VarChar(100) // 成品仓库
  deliveryDate        String?   @map("delivery_date") @db.VarChar(50) // 发货日期
  settlementQuantity  Decimal?  @map("settlement_quantity") @db.Decimal(18, 2) // 结算数量（吨）
  materialCost        Decimal?  @map("material_cost") @db.Decimal(18, 2) // 材料成本（元）
  materialComposition Json?     @map("material_composition") // 材料构成 JSON
  productionRecords   Json?     @map("production_records") // 使用的生产记录 JSON
  calculatedAt        DateTime? @default(now()) @map("calculated_at") @db.Timestamp(0) // 计算时间
  updatedAt           DateTime? @updatedAt @map("updated_at") @db.Timestamp(0) // 更新时间

  @@index([deliveryNumber])
  @@index([productName, productWarehouse])
  @@index([deliveryDate])
  @@map("MaterialCostCache")
}

/// 运维控制台账号（Web 登录，与业务用户分离）
